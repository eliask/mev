{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence reference v1",
  "type": "object",
  "properties": {
    "document_version_id": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "text_span",
        "structured_field",
        "media_segment"
      ]
    },
    "text_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "span_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "quote": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalization_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "field_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "segment_start_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "segment_end_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "context_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "document_version_id",
    "evidence_id",
    "kind",
    "text_sha256",
    "span_start",
    "span_end",
    "quote",
    "normalization_version",
    "record_locator",
    "field_path",
    "segment_start_seconds",
    "segment_end_seconds",
    "context_evidence_ids"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text_span"
          }
        }
      },
      "then": {
        "properties": {
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "span_start": {
            "type": "integer",
            "minimum": 0
          },
          "span_end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "normalization_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
